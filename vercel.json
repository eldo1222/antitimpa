{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/mangadex/search",
      "destination": "/api/mangadex-proxy"
    },
    {
      "source": "/api/mangadex/chapters/:mangaId",
      "destination": "/api/mangadex-proxy?action=chapters&mangaId=:mangaId"
    },
    {
      "source": "/api/mangadex/pages/:chapterId",
      "destination": "/api/mangadex-proxy?action=pages&chapterId=:chapterId"
    },
    {
      "source": "/api/mangadex/:path*",
      "destination": "/api/mangadex-proxy"
    },
    {
      "source": "/api/jikan/:path*",
      "destination": "/api/jikan-proxy"
    },
    {
      "source": "/api/komiktap/detail",
      "destination": "/api/komiktap-proxy?action=detail"
    },
    {
      "source": "/api/komiktap/chapter",
      "destination": "/api/komiktap-proxy?action=chapter"
    },
    {
      "source": "/api/komiktap/:path*",
      "destination": "/api/komiktap-proxy"
    },
    {
      "source": "/api/komikindo/detail",
      "destination": "/api/komikindo-proxy?action=detail"
    },
    {
      "source": "/api/komikindo/chapter",
      "destination": "/api/komikindo-proxy?action=chapter"
    },
    {
      "source": "/api/komikindo/:path*",
      "destination": "/api/komikindo-proxy"
    },
    {
      "source": "/api/doujindesu/:path*",
      "destination": "/api/doujindesu-proxy"
    },
    {
      "source": "/api/supabase-config",
      "destination": "/api/supabase-config"
    },
    {
      "source": "/api/proxy-image",
      "destination": "/api/image-proxy"
    },
    {
      "source": "/api/image-proxy",
      "destination": "/api/image-proxy"
    },
    {
      "source": "/api/scraper/:path*",
      "destination": "/api/scraper-proxy"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
